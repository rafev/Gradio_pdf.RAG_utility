# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.
ANTHROPIC_API_KEY=
# --- Claude ---------------------------------------------------------------
# AGENT_MODEL=claude-opus-5          # answers questions (agent loop)
# EXTRACT_MODEL=claude-opus-5        # builds the knowledge graph at ingest time
# AGENT_EFFORT=high                  # low | medium | high | xhigh | max
# AGENT_MAX_TOOL_ROUNDS=12
# ENABLE_FALLBACKS=true              # server-side refusal fallbacks (beta)

# --- Embeddings (runs locally; defaults fit an 8 GB GPU) ------------------
# EMBED_MODEL=BAAI/bge-base-en-v1.5  # or BAAI/bge-small-en-v1.5, BAAI/bge-m3
# EMBED_DEVICE=auto                  # auto | cuda | cpu
# EMBED_BATCH_SIZE=32                # halves automatically on CUDA OOM
# EMBED_MAX_SEQ_LENGTH=512
# RERANK=false                       # cross-encoder reranking (BAAI/bge-reranker-base, ~0.6 GB)

# --- Chunking ---------------------------------------------------------------
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150

# --- Serving ----------------------------------------------------------------
# PORT=8000                          # the app (and the port the Cloudflare tunnel points at)
# ADMIN_PORT=8001                    # admin console, localhost only, never tunnel it
# MAX_CONCURRENT_CHATS=2
# SESSION_HOURS=24                   # default approval length in public mode
# SESSION_QUESTION_QUOTA=30          # default questions per approved visitor
